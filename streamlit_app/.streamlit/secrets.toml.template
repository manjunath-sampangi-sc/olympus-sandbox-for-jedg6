# Streamlit Secrets Configuration Template for Olympus Analytics
# Copy this file to secrets.toml and update with your actual credentials
# DO NOT commit secrets.toml to version control

[snowflake]
account = "your_snowflake_account_identifier"  # e.g., "abc12345.us-east-1"
user = "your_snowflake_username"
password = "your_snowflake_password"
warehouse = "XS_WAREHOUSE"
database = "OLYMPUS_ANALYTICS"
schema = "GOLD"
role = "OLYMPUS_CONTRACTOR"

# Demo authentication credentials
[demo]
demo_user = "demo_user"
demo_password = "olympus2024"

# Retool integration (optional)
[retool]
api_key = "your_retool_api_key_here"  # Replace with actual Retool API key
base_url = "https://your-org.retool.com"

# OpenAI integration (optional)
[openai]
api_key = "your_openai_api_key_here"  # Optional: Replace with OpenAI API key

# Disco LMS API integration
[disco]
api_key = "your_disco_api_key_here"  # Replace with actual Disco API key from client
base_url = "https://api.disco.co"